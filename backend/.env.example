# Veilo Backend Environment Variables
FLASK_ENV=development
SECRET_KEY=veilo-dev-secret-key-change-in-production-32bytes
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional Redis URL. If omitted or unreachable, Veilo uses its built-in thread-safe in-memory store
REDIS_URL=
ROOM_TTL_SECONDS=1800
SESSION_TTL_SECONDS=3600
LOG_LEVEL=INFO
PORT=5000
